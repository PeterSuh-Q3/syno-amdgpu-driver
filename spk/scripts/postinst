#!/bin/sh
set -eu
RUNTIME=/var/packages/syno-amdgpu-runtime/target
test -c /dev/dri/renderD128 || echo "Warning: no AMD DRM render node found yet." >&2
test -x "$RUNTIME/bin/amdgpu_top"
"$RUNTIME/bin/helper/amdgpu-path-helper" install || echo "Warning: /usr/bin/amdgpu_top shim not created yet; start-stop-status will retry." >&2
"$RUNTIME/bin/helper/amdgpu-jellyfin-helper" patch
"$RUNTIME/bin/helper/amdgpu-jellyfin-helper" configure
"$RUNTIME/bin/helper/amdgpu-jellyfin-helper" restart
# 0.3.x/0.4.0 could wrap Plex Transcoder from a privileged helper.  Do not
# create that wrapper again; safely restore an existing legacy wrapper only.
"$RUNTIME/bin/helper/amdgpu-plex-restore-helper" || echo "Warning: Plex legacy wrapper was not restored automatically." >&2
