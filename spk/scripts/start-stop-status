#!/bin/sh
# DSM requires this compatibility entry point even for a daemonless package.
# Keep status read-only: DSM may poll it repeatedly. The explicit start action
# is the package boot hook and revalidates the current platform/kernel so a
# migrated NAS can stage its matching DRM bundle before the next module load.
RUNTIME=/var/packages/syno-amdgpu-runtime/target
case "${1:-}" in
  start) "$RUNTIME/bin/helper/amdgpu-driver-helper" reconcile ;;
  status) exit 0 ;;
  stop) exit 0 ;;
  log) exit 1 ;;
  *) exit 1 ;;
esac
