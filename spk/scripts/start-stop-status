#!/bin/sh
# This package only supplies user-space runtime files; DSM nevertheless
# requires a lifecycle entry point for third-party SPKs.
case "${1:-}" in
  # The runtime has no daemon.  Returning success for status makes DSM mark
  # the package as "running" even though there is nothing to start.
  start|stop) exit 0 ;;
  status) exit 1 ;;
  *) exit 0 ;;
esac
