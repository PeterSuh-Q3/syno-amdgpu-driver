#!/bin/sh
set -eu

PACKAGE_ROOT=/var/packages/syno-amdgpu-runtime/target
ASSET_ROOT=$PACKAGE_ROOT/share/syno-amdgpu-driver/driver-assets
FIRMWARE_PAYLOAD=$ASSET_ROOT/firmware
MODULES=/lib/modules
FIRMWARE=/lib/firmware
KVER=$(uname -r)
TARGET_DSM=7.4
TARGET_KERNEL=
TARGET_PLATFORM=
PAYLOAD=
BACKUP=
DEPMOD_LINK_MARKER=

fail() { echo "AMDGPU driver package: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || fail 'root privilege is required'; }

resolve_target() {
  case "$KVER" in
    5.10.55*) TARGET_KERNEL=kernel5.10.55 ;;
    4.4.302*) TARGET_KERNEL=kernel4.4.x ;;
    *) fail "unsupported running kernel: $KVER" ;;
  esac
  platform_info=
  if command -v synoinfo >/dev/null 2>&1; then
    platform_info=$(synoinfo --get platform 2>/dev/null || true)
  elif [ -x /usr/syno/bin/synoinfo ]; then
    platform_info=$(/usr/syno/bin/synoinfo --get platform 2>/dev/null || true)
  elif [ -x /usr/syno/sbin/synoinfo ]; then
    platform_info=$(/usr/syno/sbin/synoinfo --get platform 2>/dev/null || true)
  fi
  TARGET_PLATFORM=$(printf '%s\n' "$platform_info" | sed -n 's/^[^:]*:[[:space:]]*//p' | head -n 1 | tr -d '\r')
  if [ -z "$TARGET_PLATFORM" ]; then
    # Some DSM images do not ship a standalone synoinfo binary. Synology's
    # kernel build identity still reports e.g. synology_epyc7002_sa6400.
    TARGET_PLATFORM=$(uname -a | sed -n 's/.*[[:space:]]synology_\([[:alnum:]-]*\)_.*/\1/p' | head -n 1)
  fi
  case "$TARGET_KERNEL:$TARGET_PLATFORM" in
    kernel5.10.55:epyc7002|kernel5.10.55:epyc7003|kernel5.10.55:geminilakenk|kernel5.10.55:icelaked|kernel5.10.55:r1000nk|kernel5.10.55:v1000nk) ;;
    kernel4.4.x:apollolake|kernel4.4.x:broadwell|kernel4.4.x:broadwellnk|kernel4.4.x:broadwellnkv2|kernel4.4.x:broadwellntbap|kernel4.4.x:denverton|kernel4.4.x:geminilake|kernel4.4.x:purley|kernel4.4.x:r1000|kernel4.4.x:v1000) ;;
    *) fail "unsupported or mismatched DSM platform/kernel: ${TARGET_PLATFORM:-unknown}/$KVER" ;;
  esac
  PAYLOAD=$ASSET_ROOT/$TARGET_PLATFORM-$TARGET_DSM-$TARGET_KERNEL
  # Keep the epyc7002 backup namespace used by the pilot so an upgrade does
  # not replace the original pre-package backup with the pilot's own modules.
  BACKUP=/var/packages/syno-amdgpu-runtime/var/driver-backup/${TARGET_PLATFORM}-${TARGET_DSM}
  DEPMOD_LINK_MARKER=$BACKUP/depmod-link-created-by-package
  [ -d "$PAYLOAD" ] || fail "no bundled driver assets for $TARGET_PLATFORM"
  [ "$(sed -n 's/^platform=//p' "$PAYLOAD/target.conf")" = "$TARGET_PLATFORM" ] || fail 'payload platform manifest mismatch'
  [ "$(sed -n 's/^dsm=//p' "$PAYLOAD/target.conf")" = "$TARGET_DSM" ] || fail 'payload DSM manifest mismatch'
  [ "$(sed -n 's/^kernel=//p' "$PAYLOAD/target.conf")" = "$TARGET_KERNEL" ] || fail 'payload kernel manifest mismatch'
}

install_kernel4_autoload() {
  [ "$TARGET_KERNEL" = kernel4.4.x ] || return 0
  modules_conf=/etc/modules-load.d/syno-amdgpu-runtime.conf
  boot_hook=/usr/local/etc/rc.d/syno-amdgpu-runtime.sh
  boot_source=$PACKAGE_ROOT/bin/helper/amdgpu-driver-boot.sh
  autoload_list=$BACKUP/autoload-files.list
  mkdir -p /etc/modules-load.d /usr/local/etc/rc.d "$BACKUP"
  touch "$autoload_list"

  if [ -e "$modules_conf" ] || [ -L "$modules_conf" ]; then
    [ "$(cat "$modules_conf" 2>/dev/null || true)" = i915 ] || fail "refusing to overwrite existing $modules_conf"
  else
    printf 'modules-load\n' >> "$autoload_list"
    tmp_conf=$(mktemp /etc/modules-load.d/.syno-amdgpu-runtime.XXXXXX)
    printf 'i915\n' > "$tmp_conf"
    chmod 0644 "$tmp_conf"
    chown root:root "$tmp_conf"
    mv -f "$tmp_conf" "$modules_conf"
  fi

  [ -s "$boot_source" ] || fail 'missing kernel-4 boot loader script'
  if [ -e "$boot_hook" ] || [ -L "$boot_hook" ]; then
    cmp -s "$boot_source" "$boot_hook" || fail "refusing to overwrite existing $boot_hook"
  else
    printf 'boot-hook\n' >> "$autoload_list"
    install -o root -g root -m 0755 "$boot_source" "$boot_hook"
  fi
}

remove_kernel4_autoload() {
  autoload_list=$BACKUP/autoload-files.list
  [ -f "$autoload_list" ] || return 0
  while IFS= read -r item; do
    case "$item" in
      modules-load)
        path=/etc/modules-load.d/syno-amdgpu-runtime.conf
        expected=i915
        ;;
      modprobe-options)
        path=/etc/modprobe.d/syno-amdgpu-runtime.conf
        expected='options amdgpu exp_hw_support=1'
        ;;
      boot-hook)
        path=/usr/local/etc/rc.d/syno-amdgpu-runtime.sh
        source=$PACKAGE_ROOT/bin/helper/amdgpu-driver-boot.sh
        if [ -f "$source" ] && [ -f "$path" ] && cmp -s "$source" "$path"; then
          rm -f "$path"
        else
          echo "Keeping $path because it no longer matches the package-created boot hook." >&2
        fi
        continue
        ;;
      *) continue ;;
    esac
    if [ -f "$path" ] && [ "$(cat "$path" 2>/dev/null || true)" = "$expected" ]; then
      rm -f "$path"
    else
      echo "Keeping $path because it no longer matches the package-created configuration." >&2
    fi
  done < "$autoload_list"
  rm -f "$autoload_list"
}

ensure_depmod() {
  if [ -x /sbin/depmod ]; then
    return 0
  fi
  [ ! -e /sbin/depmod ] && [ ! -L /sbin/depmod ] || fail '/sbin/depmod exists but is not executable; refusing to replace it'
  [ "$TARGET_KERNEL" = kernel4.4.x ] || fail '/sbin/depmod is unavailable for this kernel'
  [ -x /usr/bin/kmod ] || fail 'kernel-4 depmod fallback requires /usr/bin/kmod'

  # DSM 7.4 kernel-4 systems may ship kmod without the depmod command link.
  # Create only the missing alias and record ownership so uninstall can safely
  # remove it later. Never overwrite a system-provided depmod implementation.
  mkdir -p "$BACKUP"
  : > "$DEPMOD_LINK_MARKER"
  ln -s /usr/bin/kmod /sbin/depmod || fail 'could not create the kernel-4 /sbin/depmod compatibility link'
  [ -x /sbin/depmod ] && [ "$(readlink /sbin/depmod 2>/dev/null || true)" = /usr/bin/kmod ] || {
    rm -f "$DEPMOD_LINK_MARKER"
    fail 'created depmod compatibility link did not validate'
  }
}

install_assets() {
  need_root
  resolve_target
  [ -s "$PAYLOAD/drm-modules.tgz" ] || fail 'missing platform DRM payload'
  [ -s "$FIRMWARE_PAYLOAD/firmware-amdgpu.tgz" ] && [ -s "$FIRMWARE_PAYLOAD/firmware-i915.tgz" ] || fail 'missing shared firmware payload'
  (cd "$PAYLOAD" && sha256sum -c SHA256SUMS) || fail 'DRM payload checksum validation failed'
  (cd "$FIRMWARE_PAYLOAD" && sha256sum -c SHA256SUMS) || fail 'firmware payload checksum validation failed'

  tmp=$(mktemp -d /tmp/syno-amdgpu-driver.XXXXXX)
  trap 'rm -rf "$tmp"' EXIT HUP INT TERM
  mkdir -p "$tmp/modules" "$tmp/fw-amd" "$tmp/fw-i915" "$tmp/root/lib/modules/$KVER"
  tar -xzf "$PAYLOAD/drm-modules.tgz" -C "$tmp/modules"
  tar -xzf "$FIRMWARE_PAYLOAD/firmware-amdgpu.tgz" -C "$tmp/fw-amd"
  tar -xzf "$FIRMWARE_PAYLOAD/firmware-i915.tgz" -C "$tmp/fw-i915"
  set -- "$tmp/modules"/*.ko
  [ -f "$1" ] || fail 'module archive contains no .ko files'

  # Build a standard temporary module tree. The source DSM uses a flat module
  # directory, so indexes are generated in the kernel-release layout and then
  # copied back flat. Nothing on the live system is changed until depmod exits.
  for f in "$MODULES"/*.ko; do
    [ -f "$f" ] || continue
    ln -s "$f" "$tmp/root/lib/modules/$KVER/$(basename "$f")"
  done
  for f in "$tmp/modules"/*.ko; do
    rm -f "$tmp/root/lib/modules/$KVER/$(basename "$f")"
    cp -p "$f" "$tmp/root/lib/modules/$KVER/"
  done
  ensure_depmod
  /sbin/depmod -b "$tmp/root" "$KVER" || fail 'depmod failed; live modules were not changed'

  mkdir -p "$BACKUP/modules" "$BACKUP/firmware" "$BACKUP/indexes"
  if [ ! -f "$BACKUP/modules.list" ]; then
    : > "$BACKUP/modules.list"
    for f in "$tmp/modules"/*.ko; do
      name=$(basename "$f")
      if [ -e "$MODULES/$name" ]; then
        printf 'P %s\n' "$name" >> "$BACKUP/modules.list"
        cp -p "$MODULES/$name" "$BACKUP/modules/$name"
      else
        printf 'N %s\n' "$name" >> "$BACKUP/modules.list"
      fi
    done
  fi
  if [ ! -f "$BACKUP/indexes.list" ]; then
    : > "$BACKUP/indexes.list"
    for f in "$MODULES"/modules.*; do
      [ -f "$f" ] || continue
      name=$(basename "$f")
      printf 'P %s\n' "$name" >> "$BACKUP/indexes.list"
      cp -p "$f" "$BACKUP/indexes/$name"
    done
  fi
  if [ ! -f "$BACKUP/firmware.list" ]; then
    : > "$BACKUP/firmware.list"
    for root in "$tmp/fw-amd" "$tmp/fw-i915"; do
      (cd "$root" && find . -type f -print) | while IFS= read -r rel; do
        rel=${rel#./}
        src=$root/$rel
        dst=$FIRMWARE/$rel
        if [ -e "$dst" ]; then
          printf 'P %s\n' "$rel" >> "$BACKUP/firmware.list"
          mkdir -p "$BACKUP/firmware/$(dirname "$rel")"
          cp -p "$dst" "$BACKUP/firmware/$rel"
        else
          printf 'N %s\n' "$rel" >> "$BACKUP/firmware.list"
        fi
      done
    done
  fi

  for f in "$tmp/modules"/*.ko; do cp -p "$f" "$MODULES/$(basename "$f")"; done
  for f in "$tmp/root/lib/modules/$KVER"/modules.*; do
    [ -f "$f" ] || continue
    cp -p "$f" "$MODULES/$(basename "$f")"
  done
  for root in "$tmp/fw-amd" "$tmp/fw-i915"; do
    (cd "$root" && find . -type f -print) | while IFS= read -r rel; do
      rel=${rel#./}
      mkdir -p "$FIRMWARE/$(dirname "$rel")"
      cp -p "$root/$rel" "$FIRMWARE/$rel"
    done
  done
  install_kernel4_autoload
  echo 'AMDGPU and combined DRM modules plus AMD/i915 firmware installed. Reboot DSM once before validating GPU status or hardware transcoding.'
}

restore_assets() {
  need_root
  resolve_target
  [ -d "$BACKUP" ] || { echo 'No driver backup found; nothing to restore.'; return 0; }
  if [ -f "$BACKUP/modules.list" ]; then
    while read -r state name; do
      [ -n "$name" ] || continue
      case "$state" in
        P) cp -p "$BACKUP/modules/$name" "$MODULES/$name" ;;
        N) rm -f "$MODULES/$name" ;;
      esac
    done < "$BACKUP/modules.list"
  fi
  if [ -f "$BACKUP/indexes.list" ]; then
    for f in "$MODULES"/modules.*; do [ -f "$f" ] && rm -f "$f"; done
    while read -r state name; do
      [ -n "$name" ] || continue
      [ "$state" = P ] && cp -p "$BACKUP/indexes/$name" "$MODULES/$name"
    done < "$BACKUP/indexes.list"
  fi
  if [ -f "$BACKUP/firmware.list" ]; then
    while read -r state rel; do
      [ -n "$rel" ] || continue
      case "$state" in
        P) mkdir -p "$FIRMWARE/$(dirname "$rel")"; cp -p "$BACKUP/firmware/$rel" "$FIRMWARE/$rel" ;;
        N) rm -f "$FIRMWARE/$rel" ;;
      esac
    done < "$BACKUP/firmware.list"
  fi
  if [ -f "$DEPMOD_LINK_MARKER" ]; then
    if [ "$(readlink /sbin/depmod 2>/dev/null || true)" = /usr/bin/kmod ]; then
      rm -f /sbin/depmod
      echo 'Package-created /sbin/depmod compatibility link removed.'
    else
      echo 'Keeping /sbin/depmod because it no longer matches the package-created link.' >&2
    fi
    rm -f "$DEPMOD_LINK_MARKER"
  fi
  remove_kernel4_autoload
  echo 'Original module, index, and firmware files restored. Reboot to unload any active AMDGPU module.'
}

case "${1:-}" in
  install) install_assets ;;
  restore) restore_assets ;;
  load)
    need_root
    resolve_target
    if [ -d /sys/module/amdgpu ]; then
      if [ "$TARGET_KERNEL" = kernel4.4.x ] && [ "$(cat /sys/module/amdgpu/parameters/exp_hw_support 2>/dev/null || true)" != 1 ]; then
        fail 'AMDGPU is already loaded without exp_hw_support=1; unload it safely or reboot to apply the experimental K4 option'
      fi
    else
      case "$TARGET_KERNEL" in
        kernel4.4.x) /sbin/modprobe amdgpu exp_hw_support=1 ;;
        kernel5.10.55) /sbin/modprobe amdgpu ;;
      esac || { echo 'AMDGPU module could not be loaded; inspect dmesg.' >&2; exit 1; }
    fi
    if [ "$TARGET_KERNEL" = kernel4.4.x ]; then
      /sbin/modprobe i915 || { echo 'i915 module could not be loaded; inspect dmesg.' >&2; exit 1; }
    fi
    ;;
  *) fail 'usage: amdgpu-driver-assets {install|restore|load}' ;;
esac
