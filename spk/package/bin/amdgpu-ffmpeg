#!/bin/sh
# AMD VA-API-enabled entry point for the installed SynologyCommunity FFmpeg.
# Override FFMPEG_BIN only when intentionally selecting another FFmpeg build.
set -eu
ROOT=/var/packages/syno-amdgpu-runtime/target
FFMPEG_BIN=${FFMPEG_BIN:-/var/packages/ffmpeg7/target/bin/ffmpeg}
[ -x "$FFMPEG_BIN" ] || {
  echo "amdgpu-ffmpeg: FFmpeg not found: $FFMPEG_BIN" >&2
  exit 127
}

# /dev/shm is recreated on boot.  Recreate Jellyfin's private transcoding
# workspace on demand using the invoking Jellyfin account's ownership.
SHM_TRANSCODE_DIR=${SHM_TRANSCODE_DIR:-/dev/shm/jellyfin}
if [ ! -d "$SHM_TRANSCODE_DIR" ]; then
  (umask 077 && mkdir -p "$SHM_TRANSCODE_DIR") 2>/dev/null || true
fi

exec "$ROOT/bin/amdgpu-env" "$FFMPEG_BIN" "$@"
