package="syno-amdgpu-runtime"
version="0.5.4"
displayname="Synology AMD+i915 Dual DRM and Runtime"
description="Platform-migration-capable AMD+i915 Dual DRM and Runtime (DSM 7.4, kernel 5.10.55; AMD VA-API/Vulkan). Bundled platforms: epyc7002 epyc7003 geminilakenk icelaked r1000nk v1000nk. Detects platform/kernel changes, validates the selected module ABI, and stages the matching DRM bundle; reboot if DRM modules are already loaded."
arch="epyc7002"
os_min_ver="7.4-00000"
maintainer="PeterSuh-Q3"
maintainer_url="https://github.com/PeterSuh-Q3/syno-amdgpu-driver"
distributor="PeterSuh-Q3"
distributor_url="https://github.com/PeterSuh-Q3/syno-amdgpu-driver"
support_url="https://github.com/PeterSuh-Q3/syno-amdgpu-driver/issues"
thirdparty="yes"
beta="false"
# DSM 7.4 needs both flags for a daemonless runtime: startable prevents a
# Start action from being offered, while ctl_stop removes service controls.
startable="no"
ctl_stop="no"
ctl_uninstall="yes"
support_conf_folder="yes"
install_dep_packages=""
