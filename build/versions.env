# First DSM 7.4 epyc7002 build train. Source checksums are intentionally not
# guessed: lock each downloaded archive in sources.lock before a release build.
LIBDRM_VERSION=2.4.124
LIBVA_VERSION=2.22.0
MESA_VERSION=24.3.4
AMDGPU_TOP_VERSION=0.11.5
LLVM_VERSION=18.1.8
ELFUTILS_VERSION=0.192
ZLIB_VERSION=1.3.1

LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-${LIBDRM_VERSION}.tar.xz
LIBVA_URL=https://github.com/intel/libva/releases/download/${LIBVA_VERSION}/libva-${LIBVA_VERSION}.tar.bz2
MESA_URL=https://archive.mesa3d.org/mesa-${MESA_VERSION}.tar.xz
AMDGPU_TOP_URL=https://github.com/Umio-Yasuno/amdgpu_top/archive/refs/tags/v${AMDGPU_TOP_VERSION}.tar.gz
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/llvm-project-${LLVM_VERSION}.src.tar.xz
ELFUTILS_URL=https://sourceware.org/elfutils/ftp/${ELFUTILS_VERSION}/elfutils-${ELFUTILS_VERSION}.tar.bz2
ZLIB_URL=https://zlib.net/fossils/zlib-${ZLIB_VERSION}.tar.gz
